{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"baseUrl": "./resources",
		"paths": {
			"@/*": ["*"]
		}
	},
	"include": [
		"resources/**/*",
	],
	"exclude": ["node_modules", "vendor"]
}
