{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"jsx": "react-jsx",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"baseUrl": ".",
		"typeRoots": ["node_modules/@types", "resources/js"],
		"paths": {
			"@/*": ["resources/js/*"]
		}
	},
	"include": [
		"resources/**/*",
		"resources/js/global.d.ts"
	],
	"exclude": ["node_modules", "vendor"]
}
